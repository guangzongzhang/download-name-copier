{
  "manifest_version": 3,
  "name": "下载资源名称复制助手",
  "version": "1.0.0",
  "description": "识别网页上的可下载资源(.docx/.pdf/.xls 等)，右键快速复制文件名称文字",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "下载资源名称复制助手"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}